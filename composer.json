{
    "name": "S_S0F/telegram-bot", // استبدل your-vendor باسم مستخدمك أو اسم فريقك
    "description": "A Telegram bot written in PHP.",
    "type": "project",
    "require": {
        "php": "^8.0",         // تحديد الحد الأدنى لإصدار PHP (يمكن تعديله حسب الحاجة)
        "ext-json": "*",       // البوت يستخدم دوال JSON بكثافة
        "ext-curl": "*",       // البوت يستخدم file_get_contents للوصول لـ API (cURL مطلوب غالبًا)
        "ext-mbstring": "*"    // البوت قد يستخدم دوال التعامل مع النصوص متعددة البايتات
    },
    "authors": [
        {
            "name": "S_S0F", // اسمك
            "email": "your.email@example.com" // بريدك الإلكتروني (اختياري)
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/" // إعداد Autoload أساسي (حتى لو لم تستخدمه الآن، فهو ممارسة جيدة)
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "start": "php index.php" // طريقة لتحديد أمر البدء (قد تستخدمه Koyeb)
    }
}